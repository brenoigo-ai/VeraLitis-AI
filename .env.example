# Copie este arquivo para .env e insira sua chave do Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=COLE_SUA_CHAVE_AQUI
# Modelo Gemini ativo. Projetos novos do AI Studio devem usar gemini-3.8-flash (o gemini-2.5-flash fica restrito a quem ja o usava).
GEMINI_MODEL=gemini-3.8-flash
# Se publicar atras de proxy (Render, Railway, Heroku, nginx), defina TRUST_PROXY=1 para o rate limit ver o IP real do usuario.
# TRUST_PROXY=1
PORT=3000
PEDIDOS_PATH=./data/pedidos.json