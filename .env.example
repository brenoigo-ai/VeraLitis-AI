# Copie este arquivo para .env e insira sua chave do Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=COLE_SUA_CHAVE_AQUI
# Modelo Gemini ativo (padrao: gemini-2.5-flash; em projetos novos do AI Studio pode-se usar gemini-3.8-flash)
GEMINI_MODEL=gemini-2.5-flash
PORT=3000
PEDIDOS_PATH=./data/pedidos.json